{
  "name": "undertone",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "installer": "npm run sidecar && tauri build --config src-tauri/tauri.installer.conf.json",
    "icon": "tauri icon app-icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
